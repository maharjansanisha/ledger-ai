# --- Secrets (never commit) ---
.env
.env.*
!.env.example
.streamlit/secrets.toml

# --- Local data: the real ledger, receipt images, LLM response cache ---
data/ledger.db
data/eval_ledger.db
*.db-journal
data/images/*
!data/images/.gitkeep
data/cache/*
!data/cache/.gitkeep
# Eval receipt images stay local until masked (r001 is a medical receipt).
data/eval/**/*.png
data/eval/**/*.jpg
data/eval/**/*.jpeg

# --- Python / tooling ---
.venv/
__pycache__/
*.pyc
.pytest_cache/

# --- OS / editor ---
.DS_Store
.vscode/
.idea/

# --- Spike outputs (may contain receipt data) ---
scratch/outputs/

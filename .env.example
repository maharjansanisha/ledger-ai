# Copy this file to `.env` and fill in real values.
# `.env` is gitignored; this example file is committed so others know what to set.

# Gemini API key from Google AI Studio (free tier).
GEMINI_API_KEY=your-gemini-api-key-here
# Optional: Gemini model id. Defaults to the one chosen in TASK-002 (config.DEFAULT_MODEL_NAME).
# GEMINI_MODEL=gemini-3.5-flash-lite

# Neon Postgres (ARCHITECTURE.md Amendment A1). Use the DIRECT (non "-pooler") host.
# Owner role: creates tables and saves confirmed receipts.
DATABASE_URL=postgresql://<owner>:<password>@<direct-host>/neondb?sslmode=require
# Read-only role used ONLY by "Ask Your Ledger" (SELECT on receipts, line_items).
DATABASE_URL_READONLY=postgresql://ledger_reader:<password>@<direct-host>/neondb?sslmode=require
# Separate databases for evaluation and tests (never point these at neondb).
EVAL_DATABASE_URL=postgresql://<owner>:<password>@<direct-host>/ledger_eval?sslmode=require
TEST_DATABASE_URL=postgresql://<owner>:<password>@<direct-host>/ledger_test?sslmode=require
# Optional, test-only (not part of the app): ledger_reader connected to ledger_test instead of
# neondb, so tests/test_db.py can check the ROLE's own grants (e.g. receipt_audit is unreadable)
# without touching the main database. Needs `make migrate TARGET=test` to have run (revision
# 0002 grants ledger_reader on ledger_test too). Skipped automatically if left unset.
# TEST_DATABASE_URL_READONLY=postgresql://ledger_reader:<password>@<direct-host>/ledger_test?sslmode=require
